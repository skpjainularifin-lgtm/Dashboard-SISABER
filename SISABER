let fT_q='';
function genNoTugas(){
  const now=new Date();
  const urut=String(state.suratTugas.length+1).padStart(3,'0');
  const romawi=['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII'];
  return `ST.${urut}/${ORG.kode}/${romawi[now.getMonth()]}/${now.getFullYear()}`;
}
function genNoAgendaTugas(){
  return 'ST-'+String(Math.max(0,...state.suratTugas.map(s=>parseInt(s.na.split('-')[1])||0))+1).padStart(3,'0');
}
