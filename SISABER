<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
:root{
  --bg:#0c1117;--bg2:#111922;--card:#172030;--card2:#1c2840;
  --border:#263350;--fg:#e4eaf2;--muted:#6e829e;
  --accent:#00d4aa;--accent2:#00f0c8;--danger:#ff4d5e;
  --warn:#ffb020;--info:#3ea8e0;--ok:#30d670;--purple:#9b7cff;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Source Sans 3',sans-serif;background:var(--bg);color:var(--fg);overflow-x:hidden}
h1,h2,h3,.fp{font-family:'Playfair Display',serif}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--accent)}

/* Sidebar */
.sb{width:250px;min-height:100vh;background:var(--bg2);border-right:1px solid var(--border);position:fixed;left:0;top:0;z-index:50;transition:transform .3s;display:flex;flex-direction:column}
.sb-off{transform:translateX(-250px)}
.ni{display:flex;align-items:center;gap:11px;padding:11px 18px;color:var(--muted);cursor:pointer;transition:all .2s;border-left:3px solid transparent;font-weight:500;font-size:12pt}
.ni:hover{color:var(--fg);background:rgba(0,212,170,.05)}
.ni.on{color:var(--accent);background:rgba(0,212,170,.09);border-left-color:var(--accent)}
.ni i{width:18px;text-align:center;font-size:12pt}

/* Main */
.mc{margin-left:250px;min-height:100vh;transition:margin .3s}
.mc-fm{margin-left:0}

/* Components */
.crd{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:22px;transition:all .25s}
.crd:hover{border-color:rgba(0,212,170,.25)}
.sc{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px 22px;position:relative;overflow:hidden;transition:all .25s}
.sc:hover{transform:translateY(-2px);border-color:rgba(0,212,170,.35);box-shadow:0 6px 24px rgba(0,212,170,.06)}

.btn{padding:9px 18px;border-radius:7px;font-weight:600;cursor:pointer;transition:all .2s;border:none;font-size:12pt;display:inline-flex;align-items:center;gap:7px;font-family:'Source Sans 3',sans-serif;white-space:nowrap}
.bp{background:var(--accent);color:#0c1117}.bp:hover{background:var(--accent2);transform:translateY(-1px)}
.bs{background:var(--card2);color:var(--fg);border:1px solid var(--border)}.bs:hover{border-color:var(--accent);color:var(--accent)}
.bd{background:rgba(255,77,94,.12);color:var(--danger);border:1px solid rgba(255,77,94,.25)}.bd:hover{background:rgba(255,77,94,.2)}
.bw{background:rgba(155,124,255,.12);color:var(--purple);border:1px solid rgba(155,124,255,.25)}.bw:hover{background:rgba(155,124,255,.2)}
.sm{padding:5px 12px;font-size:12px}

.fi{width:100%;padding:9px 13px;background:var(--bg);border:1px solid var(--border);border-radius:7px;color:var(--fg);font-size:12pt;font-family:'Source Sans 3',sans-serif;transition:border .2s}
.fi:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(0,212,170,.1)}
.fl{display:block;font-weight:600;margin-bottom:5px;color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.5px}
select.fi{cursor:pointer}
textarea.fi{resize:vertical;min-height:80px}

.dt{width:100%;border-collapse:separate;border-spacing:0}
.dt th{background:var(--bg2);color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.5px;padding:11px 14px;text-align:left;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:2}
.dt td{padding:12px 14px;border-bottom:1px solid rgba(38,51,80,.5);font-size:12pt;vertical-align:middle}
.dt tbody tr{transition:background .15s;cursor:pointer}
.dt tbody tr:hover{background:rgba(0,212,170,.03)}

.bg{padding:3px 9px;border-radius:5px;font-size:11px;font-weight:600;display:inline-block}
.b-masuk{background:rgba(62,168,224,.13);color:#6fb8e8}
.b-keluar{background:rgba(0,212,170,.13);color:var(--accent)}
.b-proses{background:rgba(255,176,32,.13);color:var(--warn)}
.b-selesai{background:rgba(48,214,112,.13);color:var(--ok)}
.b-tertunda{background:rgba(255,77,94,.13);color:var(--danger)}

.mo{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(4px);z-index:100;display:none;align-items:center;justify-content:center;padding:20px}
.mo.av{display:flex}
.mb{background:var(--card);border:1px solid var(--border);border-radius:14px;width:100%;max-height:92vh;overflow-y:auto;animation:mi .3s ease}
@keyframes mi{from{opacity:0;transform:scale(.96) translateY(8px)}to{opacity:1;transform:scale(1) translateY(0)}}

.tc{position:fixed;top:18px;right:18px;z-index:200;display:flex;flex-direction:column;gap:9px}
.tt{padding:13px 18px;border-radius:9px;font-weight:500;font-size:12pt;animation:ti .3s ease,to .3s ease 2.7s forwards;display:flex;align-items:center;gap:9px;min-width:260px}
.t-ok{background:rgba(48,214,112,.13);color:var(--ok);border:1px solid rgba(48,214,112,.25)}
.t-err{background:rgba(255,77,94,.13);color:var(--danger);border:1px solid rgba(255,77,94,.25)}
.t-inf{background:rgba(62,168,224,.13);color:#6fb8e8;border:1px solid rgba(62,168,224,.25)}
@keyframes ti{from{opacity:0;transform:translateX(28px)}to{opacity:1;transform:translateX(0)}}
@keyframes to{from{opacity:1}to{opacity:0;transform:translateX(28px)}}

.glow{position:absolute;border-radius:50%;filter:blur(80px);pointer-events:none;opacity:.35}
.pulse{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:pul 2s infinite}
@keyframes pul{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}

.di{display:flex;gap:11px;padding:12px 0;border-bottom:1px solid rgba(38,51,80,.3)}
.di:last-child{border-bottom:none}
.dd{width:30px;height:30px;border-radius:50%;background:var(--card2);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:11px;color:var(--accent)}

.tb{padding:9px 18px;font-weight:600;color:var(--muted);border-bottom:2px solid transparent;cursor:pointer;transition:all .2s;background:none;border-top:none;border-left:none;border-right:none;font-family:'Source Sans 3',sans-serif;font-size:12pt}
.tb:hover{color:var(--fg)}
.tb.on{color:var(--accent);border-bottom-color:var(--accent)}

.fu{animation:fadeUp .35s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

.es{text-align:center;padding:50px 18px;color:var(--muted)}
.es i{font-size:42px;margin-bottom:14px;opacity:.25}

.avatar{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12pt;color:#fff;flex-shrink:0}

/* Print */
@media print{
  body *{visibility:hidden}
  #printArea,#printArea *{visibility:visible}
  #printArea{position:absolute;left:0;top:0;width:100%;padding:40px;background:#fff;color:#111}
  .sb,.mc header,.tc{display:none!important}
}
#printArea{background:#fff;color:#111;padding:40px 50px;border-radius:8px;font-family:Arial,sans-serif;font-size:12pt;line-height:1.5}
#printArea h2{font-size:14pt;text-align:center;margin-bottom:3px;font-family:Arial,sans-serif}
#printArea .kop{border-bottom:3px double #111;padding-bottom:12px;margin-bottom:20px;text-align:center}
#printArea .nsur{margin-top:20px;border-bottom:2px solid #111;padding-bottom:10px;margin-bottom:20px}
#printArea .isi{text-align:justify;white-space:pre-wrap;margin:20px 0}
#printArea .ttd{display:flex;justify-content:flex-end;text-align:center;margin-top:40px}
#printArea .ttd div{width:220px}

@media(max-width:768px){
  .sb{transform:translateX(-250px)}
  .sb.mo2{transform:translateX(0)}
  .mc{margin-left:0}
  .hide-sm{display:none}
}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:640px){.grid2{grid-template-columns:1fr}}
</style>
