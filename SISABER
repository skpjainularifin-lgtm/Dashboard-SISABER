const BULAN = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const BULAN_S = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agt','Sep','Okt','Nov','Des'];

function fmtDate(s){
  const d = new Date(s);
  return `${d.getDate()} ${BULAN[d.getMonth()]} ${d.getFullYear()}`;
}
function fmtDateShort(s){
  const d = new Date(s);
  return d.toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'});
}
function genNoSurat(){
  const now = new Date();
  const urut = String(state.suratKeluar.length+1).padStart(3,'0');
  const romawi = ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII'];
  return `${urut}/${ORG.kode}/G.${romawi[now.getMonth()]}/${now.getFullYear()}`;
}
function genNoAgenda(t){
  if(t==='masuk') return 'SM-'+String(Math.max(...state.suratMasuk.map(s=>parseInt(s.na.split('-')[1])||0),0)+1).padStart(3,'0');
  return 'SK-'+String(Math.max(...state.suratKeluar.map(s=>parseInt(s.na.split('-')[1])||0),0)+1).padStart(3,'0');
}
function statusLabel(s){return s==='proses'?'Proses':s==='selesai'?'Selesai':'Tertunda';}
function initials(name){
  return name.split(' ').filter(w=>!['Dr','H','M','S','Hj'].includes(w.replace(/[.,]/g,''))).slice(0,2).map(w=>w[0]).join('').toUpperCase()||name[0].toUpperCase();
}
function avatarColor(name){
  const colors=['#3ea8e0','#00d4aa','#ffb020','#9b7cff','#ff6b9d','#30d670','#ff8a4c','#5d8bff'];
  let h=0;for(let i=0;i<name.length;i++)h+=name.charCodeAt(i);
  return colors[h%colors.length];
}

function toast(msg,type='ok'){
  const c = document.getElementById('TC');
  const t = document.createElement('div');
  t.className = 'tt '+(type==='ok'?'t-ok':type==='err'?'t-err':'t-inf');
  const icons = {ok:'fa-check-circle',err:'fa-exclamation-circle',i:'fa-info-circle'};
  t.innerHTML = `<i class="fas ${icons[type]||icons.i}"></i> ${msg}`;
  c.appendChild(t);
  setTimeout(()=>t.remove(),3100);
}
