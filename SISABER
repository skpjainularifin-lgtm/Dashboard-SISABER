          <div><label class="fl">Jenis Kelamin</label><select class="fi" name="jekel"><option value="L" ${p&&p.jekel==='L'?'selected':''}>Laki-laki</option><option value="P" ${p&&p.jekel==='P'?'selected':''}>Perempuan</option></select></div>
          <div><label class="fl">Golongan</label><select class="fi" name="gol">${['I/a','I/b','I/c','I/d','II/a','II/b','II/c','II/d','III/a','III/b','III/c','III/d','IV/a','IV/b','IV/c','IV/d','IV/e'].map(g=>`<option ${p&&p.gol===g?'selected':''}>${g}</option>`).join('')}</select></div>
        </div>
        <div class="grid2" style="margin-bottom:14px">
          <div><label class="fl">Jabatan</label><input type="text" class="fi" name="jabatan" required value="${p?p.jabatan:''}" placeholder="Contoh: Staf Seksi Dikdas"></div>
          <div><label class="fl">Divisi</label><input type="text" class="fi" name="divisi" required value="${p?p.divisi:''}" placeholder="Contoh: Tata Usaha"></div>
        </div>
        <div class="grid2" style="margin-bottom:14px">
          <div><label class="fl">Pendidikan</label><select class="fi" name="pendidikan">${['SLTA','D-III','D-IV','S-1','S1','S-2','S-3','SMA/SLTA'].map(g=>`<option ${p&&p.pendidikan===g?'selected':''}>${g}</option>`).join('')}</select></div>
          <div><label class="fl">Status Kepegawaian</label><select class="fi" name="statusPeg"><option value="PNS" ${p&&p.statusPeg==='PNS'?'selected':''}>PNS</option><option value="PPPK" ${p&&p.statusPeg==='PPPK'?'selected':''}>PPPK</option><option value="P3K PW" ${p&&p.statusPeg==='P3K PW'?'selected':''}>P3K PW</option><option value="CPNS" ${p&&p.statusPeg==='CPNS'?'selected':''}>CPNS</option></select></div>
        </div>
        <div class="grid2" style="margin-bottom:14px">
          <div><label class="fl">Telepon</label><input type="text" class="fi" name="telp" required value="${p?p.telp:''}" placeholder="08xxxxxxxxxx"></div>
          <div><label class="fl">Email</label><input type="email" class="fi" name="email" required value="${p?p.email:''}" placeholder="nama@instansi.go.id"></div>
        </div>
        <div style="margin-bottom:18px"><label class="fl">Tanggal Masuk</label><input type="date" class="fi" name="tglMasuk" required value="${p?p.tglMasuk:new Date().toISOString().split('T')[0]}"></div>
        <div style="display:flex;gap:8px;justify-content:flex-end">
          <button type="button" class="bs" onclick="closeM('M2')">Batal</button>
          <button type="submit" class="bp"><i class="fas fa-save"></i> Simpan</button>
        </div>
      </form>
    </div>`;
  openM('M2');
}

function submitPegawai(e,id){
  e.preventDefault();
  const f = e.target;
  const data = {nama:f.nama.value,nip:f.nip.value,jekel:f.jekel.value,gol:f.gol.value,jabatan:f.jabatan.value,divisi:f.divisi.value,telp:f.telp.value,email:f.email.value,tglMasuk:f.tglMasuk.value,pendidikan:f.pendidikan.value,statusPeg:f.statusPeg.value};
  if(id){
    const p = state.pegawai.find(x=>x.id===id);
    Object.assign(p,data);
    toast('Data pegawai diperbarui');
  }else{
    data.id = nextIdPeg();
    state.pegawai.push(data);
    toast('Pegawai baru ditambahkan');
  }
  save(); closeM('M2'); renderPegawai();
}

function hapusPegawai(id){
  const p = state.pegawai.find(x=>x.id===id);
  if(!confirm(`Hapus pegawai "${p.nama}"?`)) return;
  state.pegawai = state.pegawai.filter(s=>s.id!==id);
  save(); renderPegawai(); toast('Pegawai dihapus','err');
}

/* ===================== ARSIP ===================== */
let fA_q='', fA_type='semua';
function renderArsip(){
  const all = [
    ...state.suratMasuk.filter(s=>s.st==='selesai').map(s=>({...s,type:'masuk',pihak:s.dari})),
    ...state.suratKeluar.filter(s=>s.st==='selesai').map(s=>({...s,type:'keluar',pihak:s.tujuan}))
  ].sort((a,b)=>new Date(b.tgl)-new Date(a.tgl));
  let f = all;
  if(fA_type==='masuk') f=f.filter(s=>s.type==='masuk');
  if(fA_type==='keluar') f=f.filter(s=>s.type==='keluar');
  if(fA_q){const q=fA_q.toLowerCase();f=f.filter(s=>s.ns.toLowerCase().includes(q)||s.ph.toLowerCase().includes(q)||s.pihak.toLowerCase().includes(q))}
  document.getElementById('p-arsip').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:12px">
      <p style="color:var(--muted)">Total: <strong style="color:var(--fg)">${f.length}</strong> surat diarsipkan</p>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <select class="fi" style="width:150px" onchange="fA_type=this.value;renderArsip()">
          ${['semua','masuk','keluar'].map(t=>`<option value="${t}" ${fA_type===t?'selected':''}>${t==='semua'?'Semua Jenis':t==='masuk'?'Surat Masuk':'Surat Keluar'}</option>`).join('')}
        </select>
        <div style="position:relative">
          <i class="fas fa-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:12px"></i>
          <input type="text" class="fi" placeholder="Cari arsip..." style="width:180px;padding-left:32px" value="${fA_q}" oninput="fA_q=this.value;renderArsip()">
        </div>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px">
      ${f.length? f.map(s=>`
        <div class="crd" style="padding:16px;cursor:pointer" onclick="${s.type==='masuk'?`detailMasuk(${s.id})`:`detailKeluar(${s.id})`}">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px">
            <span class="bg ${s.type==='masuk'?'b-masuk':'b-keluar'}">${s.type==='masuk'?'Masuk':'Keluar'}</span>
            <span style="font-size:11px;color:var(--muted)">${fmtDateShort(s.tgl)}</span>
          </div>
          <div style="font-weight:700;font-size:12pt;margin-bottom:4px">${s.ph}</div>
          <div style="font-size:12px;color:var(--muted);margin-bottom:6px">${s.pihak}</div>
          <div style="font-size:11px;color:var(--accent);font-family:monospace">${s.ns}</div>
          <div style="margin-top:10px"><button class="bs sm" onclick="event.stopPropagation();cetakSurat('${s.type}',${s.id})"><i class="fas fa-print"></i> Cetak</button></div>
        </div>`).join('') : '<div class="es" style="grid-column:1/-1"><i class="fas fa-archive"></i><p>Arsip kosong</p></div>'}
    </div>`;
}

/* ===================== KOP SURAT ===================== */
