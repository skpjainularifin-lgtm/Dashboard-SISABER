function drawChart(){
  const canvas = document.getElementById('chartBulanan');
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.width = canvas.parentElement.clientWidth - 44;
  const H = canvas.height = 200;
  const dataM = [3,5,4,7,6,8,5,9,7,6,4,state.suratMasuk.length];
  const dataK = [2,3,5,4,6,5,7,4,6,5,3,state.suratKeluar.length];
  const maxV = Math.max(...dataM,...dataK)+2;
  const cl=40, cb=H-25, ct=15, ch=cb-ct;
  const barW = Math.max(8,(W-60)/12-8);
  const gap = (W-cl-20)/12;
  ctx.clearRect(0,0,W,H);
  ctx.strokeStyle='rgba(38,51,80,.4)';ctx.lineWidth=.5;
  for(let i=0;i<=4;i++){
    const y=ct+(ch/4)*i;
    ctx.beginPath();ctx.moveTo(cl,y);ctx.lineTo(W,y);ctx.stroke();
    ctx.fillStyle='#6e829e';ctx.font='10px Source Sans 3';ctx.textAlign='right';
    ctx.fillText(Math.round(maxV-(maxV/4)*i),cl-6,y+4);
  }
  for(let i=0;i<12;i++){
    const x=cl+10+i*gap;
    const hM=(dataM[i]/maxV)*ch, hK=(dataK[i]/maxV)*ch;
    ctx.fillStyle='rgba(62,168,224,.6)';
    ctx.fillRect(x,cb-hM,barW/2-1,hM);
    ctx.fillStyle='rgba(0,212,170,.6)';
    ctx.fillRect(x+barW/2+1,cb-hK,barW/2-1,hK);
    ctx.fillStyle='#6e829e';ctx.font='10px Source Sans 3';ctx.textAlign='center';
    ctx.fillText(BULAN_S[i],x+barW/2,cb+14);
  }
  ctx.fillStyle='rgba(62,168,224,.8)';ctx.fillRect(W-150,8,10,10);
  ctx.fillStyle='#6e829e';ctx.font='11px Source Sans 3';ctx.textAlign='left';
  ctx.fillText('Masuk',W-136,17);
  ctx.fillStyle='rgba(0,212,170,.8)';ctx.fillRect(W-75,8,10,10);
  ctx.fillStyle='#6e829e';ctx.fillText('Keluar',W-61,17);
}

