    <table style="width:100%;border-collapse:collapse">
      <tr>
        <td style="width:65px;vertical-align:middle;text-align:center;padding-right:6px">
          <div style="width:55px;height:65px;border:1px solid #000;display:flex;align-items:center;justify-content:center;font-size:8pt;font-weight:bold;line-height:1.1;color:#333;font-family:Arial,sans-serif">
            LOGO<br>JATIM
          </div>
        </td>
        <td style="text-align:center;vertical-align:middle;font-family:Arial,sans-serif">
          <div style="font-size:11pt;font-weight:bold;letter-spacing:0.5px">${ORG.provinsi}</div>
          <div style="font-size:12pt;font-weight:bold">${ORG.dinas}</div>
          <div style="font-size:11pt;font-weight:bold;margin-top:1px">${ORG.nama}</div>
          <div style="font-size:11pt;font-weight:bold">${ORG.nama2}</div>
          <div style="font-size:9pt;margin-top:2px">${ORG.alamat}</div>
          <div style="font-size:9pt">Telepon ${ORG.telp} &nbsp;|&nbsp; Pos-el: ${ORG.email}</div>
        </td>
        <td style="width:65px"></td>
      </tr>
    </table>
  </div>`;
}

/* ===================== CETAK ===================== */
function cetakSurat(type,id){
  const s = type==='masuk'? state.suratMasuk.find(x=>x.id===id) : state.suratKeluar.find(x=>x.id===id);
  if(!s) return;
  const pihak = type==='masuk'? s.dari : s.tujuan;
  document.getElementById('M3C').innerHTML = `
    <div style="padding:20px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
        <h3 style="font-size:16px;font-weight:700" class="fp">Preview Cetak</h3>
        <div style="display:flex;gap:8px">
          <button class="bp" onclick="window.print()"><i class="fas fa-print"></i> Cetak</button>
          <button class="bs" onclick="closeM('M3')">Tutup</button>
        </div>
      </div>
      <div id="printArea">
        ${kopSurat()}
        <div class="nsur">
          <div>Nomor   : ${s.ns}</div>
          <div>Perihal : ${s.ph}</div>
          <div>Sifat   : Biasa</div>
        </div>
        <div style="text-align:right">Bandung, ${fmtDate(s.tgl)}</div>
        <div style="margin:14px 0">Kepada Yth.</div>
        <div style="font-weight:bold">${pihak}</div>
        <div style="margin-bottom:20px">di Tempat</div>
        <div class="isi">${s.isi}</div>
        <div class="ttd">
          <div>
            <div>${ORG.jabatanKepala}</div>
            <div style="height:70px"></div>
            <div style="border-top:1px solid #111;padding-top:4px;font-weight:bold">${ORG.kepala}</div>
            <div style="font-size:12px">NIP. ${ORG.nipKepala}</div>
          </div>
        </div>
      </div>
    </div>`;
  openM('M3');
}

/* ===================== HELPERS ===================== */
function meta(label,val){
  return `<div style="margin-bottom:12px"><span class="fl">${label}</span><div>${val===undefined||val===null||val===''?'<span style="color:var(--muted)">—</span>':val}</div></div>`;
}

function gSearch(){
  const q = document.getElementById('GS').value.toLowerCase().trim();
  if(!q) return;
  const inMasuk = state.suratMasuk.find(s=>s.ns.toLowerCase().includes(q)||s.ph.toLowerCase().includes(q)||s.dari.toLowerCase().includes(q));
  if(inMasuk){go('surat-masuk');fM_q=q;renderSuratMasuk();return}
  const inKeluar = state.suratKeluar.find(s=>s.ns.toLowerCase().includes(q)||s.ph.toLowerCase().includes(q)||s.tujuan.toLowerCase().includes(q));
  if(inKeluar){go('surat-keluar');fK_q=q;renderSuratKeluar();return}
  const inPeg = state.pegawai.find(p=>p.nama.toLowerCase().includes(q)||p.nip.includes(q));
  if(inPeg){go('pegawai');fP_q=q;renderPegawai();return}
}

/* ===================== INIT ===================== */
document.addEventListener('DOMContentLoaded',()=>{renderDashboard()});

// Modal overlay click & escape
document.querySelectorAll('.mo').forEach(m=>{
  m.addEventListener('click',e=>{if(e.target===m) m.classList.remove('av')});
});
document.addEventListener('keydown',e=>{
  if(e.key==='Escape') document.querySelectorAll('.mo.av').forEach(m=>m.classList.remove('av'));
});
