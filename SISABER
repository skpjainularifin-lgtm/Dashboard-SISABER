function submitTugas(e,id){
  e.preventDefault();
  const f=e.target;
  const dasarArr=f.dasar.value.split('\n').map(s=>s.trim()).filter(Boolean);
  const pegIds=[...f.querySelectorAll('input[name="peg"]:checked')].map(i=>parseInt(i.value));
  if(pegIds.length===0){toast('Pilih minimal satu pegawai','err');return}
  const pegSnap=pegIds.map(pid=>{
    const p=state.pegawai.find(x=>x.id===pid);
    return {id:p.id,nama:p.nama,nip:p.nip,gol:p.gol||"-",jabatan:p.jabatan};
  });
  const data={ns:f.ns.value,tgl:f.tgl.value,kota:f.kota.value,dasar:dasarArr,pegawai:pegSnap,hariTanggal:f.hariTanggal.value,waktu:f.waktu.value,tempat:f.tempat.value,tujuan:f.tujuan.value};
  if(id){
    const s=state.suratTugas.find(x=>x.id===id);
    Object.assign(s,data);
    toast('Surat tugas diperbarui');
  }else{
    data.id=nextIdTugas();
    data.na=genNoAgendaTugas();
    state.suratTugas.unshift(data);
    toast('Surat tugas berhasil dibuat');
  }
  save();closeM('M2');if(typeof renderListTugasBuat==='function') renderListTugasBuat();if(typeof renderSuratTugas==='function' && document.getElementById('p-surat-tugas') && document.getElementById('p-surat-tugas').style.display!=='none') renderSuratTugas();toast('Surat tugas berhasil disimpan');
}


function previewFromForm(form){
  const f = form;
  const dasarArr = f.dasar.value.split('\n').map(s=>s.trim()).filter(Boolean);
  const pegIds = [...f.querySelectorAll('input[name="peg"]:checked')].map(i=>parseInt(i.value));
  if(pegIds.length===0){toast('Pilih minimal satu pegawai untuk preview','err');return}
  const pegSnap = pegIds.map(pid=>{
    const p = state.pegawai.find(x=>x.id===pid);
    return {id:p.id,nama:p.nama,nip:p.nip,gol:p.gol||"-",jabatan:p.jabatan};
  });
  const temp = {
    id:0, na:'PREVIEW', ns:f.ns.value, tgl:f.tgl.value, kota:f.kota.value,
    dasar:dasarArr, pegawai:pegSnap, hariTanggal:f.hariTanggal.value,
    waktu:f.waktu.value, tempat:f.tempat.value, tujuan:f.tujuan.value
  };
  // temporarily inject and call cetak
  const orig = state.suratTugas.find(x=>x.id===0);
  state.suratTugas.unshift(temp);
  cetakTugas(0);
  state.suratTugas = state.suratTugas.filter(x=>x.id!==0);
}


function printFromForm(form){
  previewFromForm(form);
  setTimeout(()=>{
    const printBtn = document.querySelector('#M3C button[onclick*="window.print"]');
    if(printBtn) printBtn.click();
    else window.print();
  }, 400);
}

